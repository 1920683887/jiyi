<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 日志输出目录：程序工作目录下的 logs/ -->
    <property name="LOG_DIR" value="logs" />

    <!-- Console output appender -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>DEBUG</level>
        </filter>
    </appender>

    <!-- 主日志（全量） -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/jiyi.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/jiyi-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>300MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 引擎通信日志 -->
    <appender name="ENGINE_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/engine.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/engine-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>5MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>50MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 检测/连线日志 -->
    <appender name="DETECTION_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/detection.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/detection-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>5MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>50MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 错误日志（仅 ERROR 级） -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/error-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 连线全链路日志（UI + 服务 + 基础设施的连线相关） -->
    <appender name="LINK_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/link.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/link-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Logger configurations -->
    <logger name="com.jiyi.core.engine" level="DEBUG" additivity="false">
        <appender-ref ref="ENGINE_FILE" />
        <appender-ref ref="STDOUT" />
    </logger>

    <logger name="com.jiyi.service.DetectionService" level="DEBUG" additivity="false">
        <appender-ref ref="DETECTION_FILE" />
        <appender-ref ref="STDOUT" />
    </logger>

    <!-- 连线链路（检测/自动化/平台/UI 控制器）单独落 link.log，同时进主日志 -->
    <logger name="com.jiyi.service.AutomationService" level="DEBUG" additivity="false">
        <appender-ref ref="LINK_FILE" />
        <appender-ref ref="STDOUT" />
    </logger>
    <logger name="com.jiyi.infra.platform" level="DEBUG" additivity="false">
        <appender-ref ref="LINK_FILE" />
        <appender-ref ref="STDOUT" />
    </logger>
    <logger name="com.jiyi.core.detection" level="DEBUG" additivity="false">
        <appender-ref ref="LINK_FILE" />
        <appender-ref ref="STDOUT" />
    </logger>
    <logger name="com.jiyi.ui.controller.MainController" level="DEBUG" additivity="false">
        <appender-ref ref="LINK_FILE" />
        <appender-ref ref="STDOUT" />
    </logger>
    <logger name="com.jiyi.service.GameService" level="DEBUG" additivity="false">
        <appender-ref ref="LINK_FILE" />
        <appender-ref ref="STDOUT" />
    </logger>
    <logger name="com.jiyi.service.EngineService" level="DEBUG" additivity="false">
        <appender-ref ref="LINK_FILE" />
        <appender-ref ref="ENGINE_FILE" />
        <appender-ref ref="STDOUT" />
    </logger>

    <logger name="com.jiyi.service" level="DEBUG" />
    <logger name="com.jiyi.ui" level="DEBUG" />
    <logger name="com.jiyi.core" level="INFO" />

    <!-- Third-party library logging levels -->
    <logger name="org.bytedeco" level="WARN" />
    <logger name="javafx" level="WARN" />

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="FILE" />
        <appender-ref ref="ERROR_FILE" />
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
