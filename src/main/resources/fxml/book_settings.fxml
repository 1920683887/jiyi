<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jiyi.ui.controller.BookSettingController"
      spacing="10">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="开局库设置" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <!-- 开局库文件列表 -->
    <HBox spacing="10" VBox.vgrow="ALWAYS">
        <TableView fx:id="bookTable" HBox.hgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="priorityCol" text="优先级" prefWidth="60" minWidth="50" maxWidth="80"/>
                <TableColumn fx:id="nameCol" text="名称" prefWidth="200" minWidth="100"/>
                <TableColumn fx:id="pathCol" text="路径" prefWidth="280" minWidth="150"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <VBox spacing="8" alignment="TOP_CENTER" minWidth="80">
            <Button fx:id="addButton" text="添加" prefWidth="75" onAction="#onAddBook"/>
            <Button fx:id="deleteButton" text="删除" prefWidth="75" onAction="#onDeleteBook"/>
            <Region VBox.vgrow="ALWAYS" minHeight="10"/>
            <Button fx:id="moveUpButton" text="上移" prefWidth="75" onAction="#onMoveUp"/>
            <Button fx:id="moveDownButton" text="下移" prefWidth="75" onAction="#onMoveDown"/>
        </VBox>
    </HBox>

    <Separator/>

    <!-- 云库设置 -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="云库设置:"/>
        <CheckBox fx:id="cloudEnabledCheckBox" text="启用云库查询"/>
    </HBox>

    <!-- 选招策略 -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="选招策略:"/>
        <ComboBox fx:id="moveRuleCombo" prefWidth="160"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="statusLabel" text="准备就绪"/>
    </HBox>

    <!-- 底部按钮 -->
    <Separator/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="resetButton" text="恢复默认" onAction="#onReset"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="applyButton" text="确定" defaultButton="true" onAction="#onConfirm"/>
        <Button fx:id="cancelButton" text="取消" cancelButton="true" onAction="#onCancel"/>
    </HBox>

</VBox>
